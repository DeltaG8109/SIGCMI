form(method="POST" action="/auth/registro")

    input(type="text" name="nombres" placeholder="Nombres")

    input(type="text" name="apellidos" placeholder="Apellidos")

    input(type="email" name="correo" placeholder="Correo")

    input(type="text" name="telefono" placeholder="Teléfono")

    input(type="text" name="tipo_documento" placeholder="Tipo de Documento")

    input(type="text" name="numero_documento" placeholder="Número de Documento")

    input(type="password" name="password" placeholder="Contraseña")

    button(type="submit") Registrarse