extends ../layout/admin

block contenido

    h1 Citas

    br

    a(href="/citas/crear") + Nueva Cita

    br
    br

    table(class="w-full border-collapse")

        thead

            tr

                th Paciente
                th Médico
                th Especialidad
                th Fecha
                th Hora
                th Motivo
                th Estado
                th Acciones

        tbody

            each cita in citas

                tr

                    td
                        = cita.paciente.usuario.nombres + ' ' + cita.paciente.usuario.apellidos

                    td
                        = cita.medico.usuario.nombres + ' ' + cita.medico.usuario.apellidos

                    td
                        = cita.medico.especialidad.nombre

                    td
                        = cita.fecha

                    td
                        = cita.hora

                    td
                        = cita.motivo_consulta

                    td

                        if cita.estado.nombre === 'Pendiente'

                            span(style="background:#FEF3C7;color:#92400E;padding:6px 12px;border-radius:20px;")
                                = cita.estado.nombre

                        else if cita.estado.nombre === 'Completada'

                            span(style="background:#DCFCE7;color:#166534;padding:6px 12px;border-radius:20px;")
                                = cita.estado.nombre

                        else if cita.estado.nombre === 'Cancelada'

                            span(style="background:#FEE2E2;color:#991B1B;padding:6px 12px;border-radius:20px;")
                                = cita.estado.nombre

                        else

                            span(style="background:#DBEAFE;color:#1E40AF;padding:6px 12px;border-radius:20px;")
                                = cita.estado.nombre

                    td

                        if cita.estado.nombre === 'Pendiente'

                            a(
                                href=`/citas/confirmar/${cita.id_cita}`
                                title="Confirmar"
                            ) ✅

                            |  

                        if cita.estado.nombre === 'Confirmada'

                            a(
                                href=`/citas/finalizar/${cita.id_cita}`
                                title="Finalizar"
                            ) 🏥

                            |  

                        if cita.estado.nombre !== 'Cancelada' && cita.estado.nombre !== 'Completada'

                            a(
                                href=`/citas/editar/${cita.id_cita}`
                                title="Editar"
                            ) ✏️

                            |

                            a(
                                href=`/citas/reprogramar/${cita.id_cita}`
                                title="Reprogramar"
                            ) 🔄

                            |

                            a(
                                href=`/citas/cancelar/${cita.id_cita}`
                                title="Cancelar"
                            ) ❌

                        else

                            span(style="color:green;font-weight:bold")
                                |✔ Finalizada