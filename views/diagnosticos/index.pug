extends ../layout/admin

block contenido

    h1 Diagnósticos

    br

    a(href="/diagnosticos/crear") + Nuevo Diagnóstico

    br
    br

    table(border="1" cellpadding="10")

        thead
            tr
                th Paciente
                th Médico
                th Fecha
                th Temperatura
                th Presión
                th Diagnóstico
                th Tratamiento
                th Acciones

        tbody

            each diagnostico in diagnosticos

                tr

                    td= diagnostico.cita.paciente.usuario.nombres + ' ' + diagnostico.cita.paciente.usuario.apellidos

                    td= diagnostico.cita.medico.usuario.nombres + ' ' + diagnostico.cita.medico.usuario.apellidos

                    td= diagnostico.cita.fecha

                    td= diagnostico.temperatura + " °C"

                    td= diagnostico.presion_arterial

                    td= diagnostico.diagnostico

                    td= diagnostico.tratamiento

                    td
                        a(href=`/diagnosticos/ver/${diagnostico.id_diagnostico}`) 👁️ Ver