doctype html
html(lang="es")

    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")

        title SIGCMI | #{pagina}

        link(rel="stylesheet" href="/css/tailwind.css")
        link(rel="stylesheet" href="/css/admin.css")

        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet")
        script(src="https://cdn.jsdelivr.net/npm/chart.js")
        
    body(class="bg-slate-100")

        .layout

            // Sidebar
            aside.sidebar

                .logo

                    h1 SIGCMI

                    p Sistema Médico

                nav.menu

                    a.menu-link(href="/dashboard")
                        span.icon 🏠
                        span Dashboard

                    a.menu-link(href="/usuarios")
                        span.icon 👤
                        span Usuarios

                    a.menu-link(href="/pacientes")
                        span.icon ❤️
                        span Pacientes

                    a.menu-link(href="/diagnosticos") 
                        span.icon 🩺 
                        span Diagnósticos

                    a.menu-link(href="/prescripciones")
                        span.icon 💊
                        span Prescripciones
                        
                    a.menu-link(href="/medicos")
                        span.icon 👨‍⚕️
                        span Médicos

                    a.menu-link(href="/especialidades")
                        span.icon 🏥
                        span Especialidades

                    a.menu-link(href="/citas")
                        span.icon 📅
                        span Citas

                    a.menu-link(href="/horarios")
                        span.icon 🕒
                        span Horarios

                    a.menu-link(href="/logout")
                        span.icon 🚪
                        span Cerrar sesión

                    

            // Contenido
            .principal

                header.topbar

                    .titulo

                        h2= pagina

                    .usuario

                        .avatar
                            | 👤

                        .info

                            strong= usuario.nombres

                            small Administrador

                main.contenido

                    block contenido
                script(src="https://cdn.jsdelivr.net/npm/chart.js")