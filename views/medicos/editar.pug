extends ../layout/admin

block contenido

    h1 Editar Médico

    form(method="POST")

        div

            label Usuario

            select(name="usuario_id" required)

                each usuario in usuarios

                    option(
                        value=usuario.id_usuario
                        selected=usuario.id_usuario === medico.usuario_id
                    )
                        = usuario.nombres + ' ' + usuario.apellidos

        br

        div

            label Especialidad

            select(name="especialidad_id" required)

                each especialidad in especialidades

                    option(
                        value=especialidad.id_especialidad
                        selected=especialidad.id_especialidad === medico.especialidad_id
                    )
                        = especialidad.nombre

        br

        div

            label Cédula Profesional

            input(
                type="text"
                name="cedula_profesional"
                value=medico.cedula_profesional
                required
            )

        br

        div

            label Años de experiencia

            input(
                type="number"
                name="anios_experiencia"
                value=medico.anios_experiencia
                min="0"
                required
            )

        br

        button(type="submit")
            Guardar Cambios