extends ../layout/admin

block contenido

    h1 Nueva Prescripción

    form(method="POST")

        label Diagnóstico

        select(name="diagnostico_id")

            each diagnostico in diagnosticos

                option(value=diagnostico.id_diagnostico)
                    = diagnostico.cita.paciente.usuario.nombres + ' ' + diagnostico.cita.paciente.usuario.apellidos

        br
        br

        label Medicamento

        input(type="text" name="nombre_medicamento" required)

        br

        label Dosis

        input(type="text" name="dosis" required)

        br

        label Frecuencia

        input(type="text" name="frecuencia" required)

        br

        label Duración

        input(type="text" name="duracion" required)

        br
        br

        button(type="submit") Guardar