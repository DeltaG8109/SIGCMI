extends ../layout/admin

block contenido

    h1 Editar Usuario

    form(method="POST")

        div
            label Nombres

            input(
                type="text"
                name="nombres"
                value=usuarioEditar.nombres
                required
            )

        br

        div
            label Apellidos

            input(
                type="text"
                name="apellidos"
                value=usuarioEditar.apellidos
                required
            )

        br

        div
            label Correo

            input(
                type="email"
                name="correo"
                value=usuarioEditar.correo
                required
            )

        br

        div
            label Teléfono

            input(
                type="text"
                name="telefono"
                value=usuarioEditar.telefono
            )

        br

        div
            label Tipo Documento

            input(
                type="text"
                name="tipo_documento"
                value=usuarioEditar.tipo_documento
            )

        br

        div
            label Número Documento

            input(
                type="text"
                name="numero_documento"
                value=usuarioEditar.numero_documento
            )

        br

        div
            label Rol

            select(name="rol_id")

                each rol in roles

                    option(
                        value=rol.id_rol
                        selected=usuarioEditar.rol_id === rol.id_rol
                    )
                        = rol.nombre

        br

        div
            label Estado

            select(name="estado")

                option(
                    value="true"
                    selected=usuarioEditar.estado
                ) Activo

                option(
                    value="false"
                    selected=!usuarioEditar.estado
                ) Inactivo

        br

        button(type="submit")
            |Actualizar